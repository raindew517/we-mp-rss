<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd 定时模板：每天 07:55 在 werss 消息任务（默认 08:00）之前自动刷新微信读书 Cookie。

  使用步骤：
    1. 将本文件复制到 ~/Library/LaunchAgents/com.user.we-mp-rss.refresh-weread.plist
    2. 按需修改下面的 ProgramArguments 中的 python 路径与脚本路径
    3. 加载：launchctl load ~/Library/LaunchAgents/com.user.we-mp-rss.refresh-weread.plist
       （或新系统：launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.user.we-mp-rss.refresh-weread.plist）
    4. 立即跑一次验证：launchctl start com.user.we-mp-rss.refresh-weread
       或直接手动执行：python scripts/refresh_weread_cookie.py
    5. 卸载：launchctl unload ~/Library/LaunchAgents/com.user.we-mp-rss.refresh-weread.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.we-mp-rss.refresh-weread</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/yangqing/.workbuddy/binaries/python/envs/default/bin/python3</string>
    <string>/Users/yangqing/we-mp-rss-main/scripts/refresh_weread_cookie.py</string>
  </array>

  <!-- 每天 07:55 执行（在消息任务 08:00 之前） -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>55</integer>
    <key>Hour</key>
    <integer>7</integer>
  </dict>

  <!-- 登录后立刻跑一次，便于首次配置验证 -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/yangqing/wechat-rss-data/refresh_weread.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/yangqing/wechat-rss-data/refresh_weread.log</string>
</dict>
</plist>
